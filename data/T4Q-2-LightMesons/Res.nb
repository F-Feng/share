  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "AA", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"j", "==", "0"}], ",", 
       RowBox[{
        RowBox[{"AA", "=", 
         RowBox[{
          SuperscriptBox[
           RowBox[{"(", 
            RowBox[{"\[Pi]", " ", 
             RowBox[{"As", "[", "\[Mu]", "]"}]}], ")"}], "3"], " ", 
          SuperscriptBox["f", "2"], " ", 
          FractionBox["1", 
           SuperscriptBox["mass", "6"]], 
          RowBox[{"Sum", "[", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{
               FractionBox["O3", "4"], 
               RowBox[{"a", "[", 
                RowBox[{
                 RowBox[{"m", "-", "1"}], ",", "\[Mu]", ",", "aM"}], "]"}], " ", 
               RowBox[{"a", "[", 
                RowBox[{
                 RowBox[{"n", "-", "1"}], ",", "\[Mu]", ",", "aM"}], "]"}], " ", 
               RowBox[{"ConvJ033", "[", 
                RowBox[{"[", 
                 RowBox[{"m", ",", "n"}], "]"}], "]"}]}], "+", 
              RowBox[{
               FractionBox["O6", "4"], 
               RowBox[{"a", "[", 
