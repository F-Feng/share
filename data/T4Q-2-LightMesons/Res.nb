               RowBox[{"Complex", "[", 
                RowBox[{"r", ",", 
                 RowBox[{"-", "i"}]}], "]"}]}]}], ")"}]}], "]"}], 
          RowBox[{"8", "\[Pi]"}]], "/.", 
