               RowBox[{"a", "[", 
                RowBox[{
                 RowBox[{"n", "-", "1"}], ",", "\[Mu]", ",", "aM"}], "]"}], " ", 
               RowBox[{"ConvJ066", "[", 
                RowBox[{"[", 
                 RowBox[{"m", ",", "n"}], "]"}], "]"}]}]}], "/.", 
             RowBox[{
              RowBox[{"VE", "[", 
               RowBox[{"v_", ",", "_"}], "]"}], ":>", "v"}]}], ",", 
            RowBox[{"{", 
             RowBox[{"m", ",", "1", ",", "9"}], "}"}], ",", 
            RowBox[{"{", 
